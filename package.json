{
  "name": "pi-straw-boss",
  "version": "0.9.5",
  "description": "Straw Boss coordination for pi in Herdr: sessions join a tab's net by choice, the first joiner is its main agent, a workspace tower opens on demand with a live monitoring dashboard, and boss_broadcast reaches the rest",
  "type": "module",
  "license": "MIT",
  "author": "wayne930242",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayne930242/pi-straw-boss.git"
  },
  "homepage": "https://github.com/wayne930242/pi-straw-boss#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "herdr",
    "intercom",
    "orchestration"
  ],
  "files": [
    "src",
    "dist/gui",
    "prompts",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./src/balance.ts",
      "./src/blocked.ts"
    ]
  },
  "scripts": {
    "check": "npm run gui:i18n && tsc --noEmit && tsc --noEmit -p gui",
    "gui:build": "npm run gui:i18n && vite build gui",
    "gui:dev": "npm run gui:i18n && vite gui",
    "prepack": "npm run gui:build",
    "pretest": "npm run gui:build",
    "test": "node --test tests/*.test.ts",
    "gui:i18n": "paraglide-js compile --project gui/project.inlang --outdir gui/paraglide --strategy baseLocale --emit-ts-declarations --no-emit-readme --no-emit-prettier-ignore --silent"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@inlang/paraglide-js": "2.29.0",
    "@inlang/plugin-message-format": "4.5.4",
    "@types/node": "26.6.5",
    "jsqr": "1.4.0",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
