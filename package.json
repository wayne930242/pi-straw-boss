{
  "name": "pi-straw-boss",
  "version": "0.4.0",
  "description": "Straw Boss coordination for pi in Herdr: sessions join a tab's net by choice, the first joiner is its main agent, a workspace tower opens on demand with a live monitoring dashboard, and boss_broadcast reaches the rest",
  "type": "module",
  "license": "MIT",
  "author": "wayne930242",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayne930242/pi-straw-boss.git"
  },
  "homepage": "https://github.com/wayne930242/pi-straw-boss#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "herdr",
    "intercom",
    "orchestration"
  ],
  "files": [
    "src",
    "dist/gui",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./src/balance.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && tsc --noEmit -p gui",
    "gui:build": "vite build gui",
    "gui:dev": "vite gui",
    "prepack": "npm run gui:build",
    "pretest": "npm run gui:build",
    "test": "node --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "26.6.5",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
